<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.nnm</groupId>
        <artifactId>NnmBot</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>nnm-render</artifactId>
    <name>nnm-render</name>
    <description>Image rendering engine - SPI pluggable (openhtmltopdf / Playwright)</description>

    <dependencies>
        <dependency>
            <groupId>com.nnm</groupId>
            <artifactId>nnm-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.nnm</groupId>
            <artifactId>nnm-common</artifactId>
        </dependency>

        <!-- 渲染：openhtmltopdf（默认、轻量） -->
        <dependency>
            <groupId>com.openhtmltopdf</groupId>
            <artifactId>openhtmltopdf-pdfbox</artifactId>
        </dependency>
        <dependency>
            <groupId>com.openhtmltopdf</groupId>
            <artifactId>openhtmltopdf-svg-support</artifactId>
        </dependency>

        <!-- 渲染：Playwright（可选，用于高保真渲染） -->
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 模板引擎：Thymeleaf（用于 HTML 模板处理） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- Lombok 代码生成 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
