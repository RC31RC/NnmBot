<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.nnm</groupId>
        <artifactId>NnmBot</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>nnm-common</artifactId>
    <name>nnm-common</name>
    <description>Common utilities, exceptions, and shared infrastructure</description>

    <dependencies>
        <!-- Spring Web（用于响应模型和异常处理） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 参数校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- GlobalExceptionHandler 使用的 Spring DAO 异常体系 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>

        <!-- Jackson JSON 处理 -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!-- 通用工具依赖 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-text</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-core</artifactId>
        </dependency>

        <!-- OCR：模型和当前开发/目标服务器的 native runtime -->
        <dependency>
            <groupId>net.linlan.tools</groupId>
            <artifactId>rapidocr</artifactId>
        </dependency>
        <dependency>
            <groupId>net.linlan.tools</groupId>
            <artifactId>rapidocr-common</artifactId>
        </dependency>
        <dependency>
            <groupId>net.linlan.tools</groupId>
            <artifactId>rapidocr-onnx-models</artifactId>
        </dependency>
        <dependency>
            <groupId>net.linlan.tools</groupId>
            <artifactId>rapidocr-onnx-macosx-arm64</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>net.linlan.tools</groupId>
            <artifactId>rapidocr-onnx-linux-x86_64</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Lombok 代码生成 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
