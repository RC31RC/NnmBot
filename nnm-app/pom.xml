<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.nnm</groupId>
        <artifactId>NnmBot</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>nnm-app</artifactId>
    <name>nnm-app</name>
    <description>Application entry point - assembles all modules</description>

    <dependencies>
        <!-- 组装全部模块 -->
        <dependency>
            <groupId>com.nnm</groupId>
            <artifactId>nnm-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.nnm</groupId>
            <artifactId>nnm-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.nnm</groupId>
            <artifactId>nnm-render</artifactId>
        </dependency>
        <dependency>
            <groupId>com.nnm</groupId>
            <artifactId>nnm-warframe</artifactId>
        </dependency>
        <dependency>
            <groupId>com.nnm</groupId>
            <artifactId>nnm-scheduler</artifactId>
        </dependency>
        <dependency>
            <groupId>com.nnm</groupId>
            <artifactId>nnm-admin</artifactId>
        </dependency>

        <!-- 数据库 -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- H2 仅用于自动化测试 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Flyway 数据库迁移 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Actuator（健康检查和指标） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 测试依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                    <mainClass>com.nnm.bot.NnmBotApplication</mainClass>
                    <additionalClasspathElements>
                        <additionalClasspathElement>
                            ${maven.multiModuleProjectDirectory}/nnm-common/target/classes
                        </additionalClasspathElement>
                        <additionalClasspathElement>
                            ${maven.multiModuleProjectDirectory}/nnm-core/target/classes
                        </additionalClasspathElement>
                        <additionalClasspathElement>
                            ${maven.multiModuleProjectDirectory}/nnm-render/target/classes
                        </additionalClasspathElement>
                        <additionalClasspathElement>
                            ${maven.multiModuleProjectDirectory}/nnm-warframe/target/classes
                        </additionalClasspathElement>
                        <additionalClasspathElement>
                            ${maven.multiModuleProjectDirectory}/nnm-scheduler/target/classes
                        </additionalClasspathElement>
                        <additionalClasspathElement>
                            ${maven.multiModuleProjectDirectory}/nnm-admin/target/classes
                        </additionalClasspathElement>
                    </additionalClasspathElements>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <finalName>NnmBot</finalName>
    </build>

</project>
