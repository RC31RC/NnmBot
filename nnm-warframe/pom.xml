<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.nnm</groupId>
        <artifactId>NnmBot</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>nnm-warframe</artifactId>
    <name>nnm-warframe</name>
    <description>Warframe domain module: market, world state, notifications</description>

    <dependencies>
        <dependency>
            <groupId>com.nnm</groupId>
            <artifactId>nnm-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.nnm</groupId>
            <artifactId>nnm-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.nnm</groupId>
            <artifactId>nnm-render</artifactId>
        </dependency>

        <!-- JPA -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Active JVM business cache -->
        <dependency>
            <groupId>org.cache2k</groupId>
            <artifactId>cache2k-spring</artifactId>
        </dependency>

        <!-- Retained temporarily for comparison and rollback; not the active CacheManager -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
