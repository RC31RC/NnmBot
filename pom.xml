<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/>
    </parent>

    <groupId>com.nnm</groupId>
    <artifactId>NnmBot</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>NnmBot</name>
    <description>QQ Bot for Warframe - Modular Architecture</description>

    <modules>
        <module>nnm-common</module>
        <module>nnm-core</module>
        <module>nnm-render</module>
        <module>nnm-warframe</module>
        <module>nnm-scheduler</module>
        <module>nnm-admin</module>
        <module>nnm-app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Spring 与 Spring Boot -->
        <spring-modulith.version>2.0.7</spring-modulith.version>

        <!-- 机器人 SDK -->
        <shiro.version>2.5.4</shiro.version>

        <!-- 数据库 -->
        <postgresql.version>42.7.5</postgresql.version>

        <!-- 缓存 -->
        <caffeine.version>3.1.8</caffeine.version>
        <cache2k.version>2.6.1.Final</cache2k.version>

        <!-- 渲染 -->
        <openhtmltopdf.version>1.0.10</openhtmltopdf.version>
        <playwright.version>1.49.0</playwright.version>
        <pdfbox.version>2.0.24</pdfbox.version>

        <!-- JMComic -->
        <jmcomic.version>1.1.8</jmcomic.version>
        <okhttp.version>4.12.0</okhttp.version>
        <webp-imageio.version>0.3.3</webp-imageio.version>

        <!-- 认证 -->
        <sa-token.version>1.45.0</sa-token.version>

        <!-- 通用工具 -->
        <commons-lang3.version>3.17.0</commons-lang3.version>
        <commons-text.version>1.13.0</commons-text.version>
        <hutool.version>5.8.27</hutool.version>

        <!-- OCR -->
        <rapidocr.version>1.0.1</rapidocr.version>
        <rapidocr.native.version>1.2.2</rapidocr.native.version>

        <!-- 文档 -->
        <springdoc.version>3.0.3</springdoc.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 内部模块 -->
            <dependency>
                <groupId>com.nnm</groupId>
                <artifactId>nnm-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.nnm</groupId>
                <artifactId>nnm-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.nnm</groupId>
                <artifactId>nnm-render</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.nnm</groupId>
                <artifactId>nnm-warframe</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.nnm</groupId>
                <artifactId>nnm-scheduler</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.nnm</groupId>
                <artifactId>nnm-admin</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Spring Modulith 模块化支持 -->
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- OneBot SDK -->
            <dependency>
                <groupId>com.mikuac</groupId>
                <artifactId>shiro</artifactId>
                <version>${shiro.version}</version>
            </dependency>

            <!-- 渲染：openhtmltopdf -->
            <dependency>
                <groupId>com.openhtmltopdf</groupId>
                <artifactId>openhtmltopdf-pdfbox</artifactId>
                <version>${openhtmltopdf.version}</version>
            </dependency>
            <dependency>
                <groupId>com.openhtmltopdf</groupId>
                <artifactId>openhtmltopdf-svg-support</artifactId>
                <version>${openhtmltopdf.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.pdfbox</groupId>
                <artifactId>pdfbox</artifactId>
                <version>${pdfbox.version}</version>
            </dependency>

            <!-- JMComic 下载客户端 -->
            <dependency>
                <groupId>io.github.jukomu</groupId>
                <artifactId>jmcomic-core</artifactId>
                <version>${jmcomic.version}</version>
            </dependency>
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>okhttp</artifactId>
                <version>${okhttp.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.darkxanter</groupId>
                <artifactId>webp-imageio</artifactId>
                <version>${webp-imageio.version}</version>
            </dependency>

            <!-- 渲染：Playwright -->
            <dependency>
                <groupId>com.microsoft.playwright</groupId>
                <artifactId>playwright</artifactId>
                <version>${playwright.version}</version>
            </dependency>

            <!-- 认证 -->
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-spring-boot4-starter</artifactId>
                <version>${sa-token.version}</version>
            </dependency>

            <!-- 通用工具 -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>${commons-lang3.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-text</artifactId>
                <version>${commons-text.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-core</artifactId>
                <version>${hutool.version}</version>
            </dependency>

            <dependency>
                <groupId>net.linlan.tools</groupId>
                <artifactId>rapidocr</artifactId>
                <version>${rapidocr.version}</version>
            </dependency>
            <dependency>
                <groupId>net.linlan.tools</groupId>
                <artifactId>rapidocr-common</artifactId>
                <version>${rapidocr.version}</version>
            </dependency>
            <dependency>
                <groupId>net.linlan.tools</groupId>
                <artifactId>rapidocr-onnx-models</artifactId>
                <version>${rapidocr.native.version}</version>
            </dependency>
            <dependency>
                <groupId>net.linlan.tools</groupId>
                <artifactId>rapidocr-onnx-macosx-arm64</artifactId>
                <version>${rapidocr.native.version}</version>
            </dependency>
            <dependency>
                <groupId>net.linlan.tools</groupId>
                <artifactId>rapidocr-onnx-linux-x86_64</artifactId>
                <version>${rapidocr.native.version}</version>
            </dependency>

            <!-- API 文档 -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- Caffeine 缓存 -->
            <dependency>
                <groupId>com.github.ben-manes.caffeine</groupId>
                <artifactId>caffeine</artifactId>
                <version>${caffeine.version}</version>
            </dependency>

            <!-- JVM 业务缓存 -->
            <dependency>
                <groupId>org.cache2k</groupId>
                <artifactId>cache2k-api</artifactId>
                <version>${cache2k.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <skip>true</skip>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
